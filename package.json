{
    "description": "智慧物流数据可视化大屏（个人项目，数据为自研模拟引擎生成的仿真数据）",
    "name": "logistics-viz-screen",
    "private": true,
    "scripts": {
        "build": "npm --prefix client run build",
        "dev": "node scripts/dev.mjs",
        "dev:client": "npm --prefix client run dev",
        "dev:server": "npm --prefix server run start",
        "install:all": "npm --prefix client install && npm --prefix server install",
        "test": "npm --prefix server test && npm --prefix client test",
        "build:routes": "NODE_USE_ENV_PROXY=1 node scripts/build-routes.mjs",
        "shots": "node scripts/screenshot.mjs --url http://localhost:4173 --out docs",
        "measure": "node scripts/measure.mjs",
        "preview": "npm --prefix client run preview"
    },
    "version": "1.0.0"
}